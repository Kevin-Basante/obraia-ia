# Copy this file to .env and fill in the values. Never commit .env.

# gemini reads blueprints with Gemini; fake returns sample measurements (no API key needed)
ANALYZER=fake

# Key from Google AI Studio (only when ANALYZER=gemini)
GEMINI_API_KEY=

# Gemini model that reads the blueprints
GEMINI_MODEL=gemini-3.5-flash

# Lighter model tried when the main one stays busy (empty turns it off)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Extra tries of each model when Gemini answers that it is busy
GEMINI_RETRIES=2

# Shared secret: the backend sends it in the X-Service-Token header
SERVICE_TOKEN=change-me

# Largest blueprint accepted, in megabytes
MAX_FILE_MB=10

# Longest PDF accepted, in pages
MAX_PDF_PAGES=10

# Analyses running at the same time; more are answered as busy
MAX_CONCURRENT_ANALYSES=2
